+    target_uri: *const c_char,
+    target_table_name: *const c_char,
+    source_uri: *const c_char,
+    source_version: u64,
+    has_source_version: bool,
+    source_tag: *const c_char,
+    storage_options_json: *const c_char,
+) -> *mut SimpleResult {
+    let result = std::panic::catch_unwind(|| -> SimpleResult {
+        if target_uri.is_null()
+            || target_table_name.is_null()
+            || source_uri.is_null()
+            || storage_options_json.is_null()
+        {
+            return SimpleResult::error("Invalid null arguments".to_string());
+        }
+        let target_uri = match from_c_str(target_uri) {
+            Ok(value) => value,
+            Err(error) => return SimpleResult::error(format!("Invalid target URI: {error}")),
+        };
+        let target = match from_c_str(target_table_name) {
+            Ok(value) => value,
+            Err(error) => {
+                return SimpleResult::error(format!("Invalid target table name: {error}"))
+            }
+        };
+        let source = match from_c_str(source_uri) {
+            Ok(value) => value,
+            Err(error) => return SimpleResult::error(format!("Invalid source URI: {error}")),
+        };
+        let tag = if source_tag.is_null() {
+            None
+        } else {
+            match from_c_str(source_tag) {
+                Ok(value) if !value.is_empty() => Some(value),
+                Ok(_) => None,
+                Err(error) => return SimpleResult::error(format!("Invalid source tag: {error}")),
+            }
+        };
+        if has_source_version && tag.is_some() {
+            return SimpleResult::error(
+                "Cannot specify both source version and source tag".to_string(),
+            );
+        }
+        let options = match from_c_str(storage_options_json)
+            .ok()
+            .and_then(|value| serde_json::from_str::<HashMap<String, String>>(&value).ok())
+        {
+            Some(value) => value,
+            None => return SimpleResult::error("Invalid storage options JSON".to_string()),
+        };
+        let rt = get_simple_runtime();
+        match rt.block_on(async {
+            let source_params = ObjectStoreParams {
+                storage_options_accessor: Some(Arc::new(
+                    StorageOptionsAccessor::with_static_options(options),
+                )),
+                ..Default::default()
+            };
+            let source_dataset = lance::dataset::builder::DatasetBuilder::from_uri(&source)
+                .with_read_params(ReadParams {
+                    store_options: Some(source_params),
+                    ..Default::default()
+                })
+                .load()
+                .await?;
+            let (ref_name, ref_version) = if let Some(tag) = tag {
+                let version = source_dataset.tags().get_version(&tag).await?;
+                (Some(tag), version)
+            } else if has_source_version {
+                (None, source_version)
+            } else {
+                (None, source_dataset.version().version)
+            };
+            let source_location = source_dataset.branch_location();
+            let transaction = Transaction::new(
+                ref_version,
+                Operation::Clone {
+                    is_shallow: true,
+                    ref_name,
+                    ref_version,
+                    ref_path: source_location.uri,
+                    branch_name: None,
+                },
+                None,
+            );
