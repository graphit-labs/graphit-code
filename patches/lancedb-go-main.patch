+            Ok(_) => SimpleResult::ok(),
+            Err(error) => SimpleResult::error(format!("clone_table failed: {error}")),
+        }
+    });
+
+    match result {
+        Ok(value) => Box::into_raw(Box::new(value)),
+        Err(_) => Box::into_raw(Box::new(SimpleResult::error(
+            "Panic in simple_lancedb_clone_table".to_string(),
+        ))),
+    }
+}
