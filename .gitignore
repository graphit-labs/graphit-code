# ── Rust build artifacts ────────────────────────────────────────────────────────
/.build/
/target
/graphit

# Test artifacts
*.test
*.out
coverage.txt
coverage.xml

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Secrets & env ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
# ── UI module ─────────────────────────────────────────────────────────────────
ui/node_modules/
ui/dist/
# Vite bundles its authored TypeScript config into a disposable import module.
/ui/vite.config.ts.timestamp-*.mjs
ui/coverage/
*.tsbuildinfo

# Graphit generated state in project checkouts
**/.graphit/runtime/
**/.graphit/cache/
**/.graphit/ast-graphs/
**/.graphit/artifact-store.json
**/.graphit/hub.json
**/.graphit/.hub.json.lock
**/.graphit/grammars/**/*.so
**/.graphit/grammars/**/*.dylib
**/.graphit/grammars/**/*.dll
**/.graphit/.project.json.lock

# Local native build output
.native/

# Local execution output and generated state
/validation/
/tmp/
/docs/.graphit-recovered/
/docs/development/validation-rust/
/docs/development/evidence/
/docs/evidence/
__pycache__/
*.py[cod]
/a.o

# ANTLR generation diagnostics are local build output.
/crates/graphit-ast/src/antlr_engine/cpp/generated/**/tool-diagnostics.log

# Installed Graphit skills are generated from maintained Markdown templates.
/.agents/skills/graphit-ast/
/.agents/skills/graphit-hub/
/.agents/skills/graphit-knowledge/
/.agents/skills/graphit-memory/
/.agents/skills/graphit-task/
