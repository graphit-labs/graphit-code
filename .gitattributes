# Keep upstream and generated parser sources byte-for-byte.
crates/graphit-ast/grammars/tree_sitter/** linguist-vendored=true -whitespace
crates/graphit-ast/src/antlr_engine/cpp/vendor/** linguist-vendored=true -whitespace
crates/graphit-ast/src/antlr_engine/cpp/generated/** linguist-generated=true -whitespace
crates/graphit-ast/src/antlr_engine/grammars/** -whitespace

# Preserve the upstream redistribution license byte-for-byte.
crates/graphit-ai/licenses/NVIDIA-CUDA-LICENSE -whitespace

# Canonical AST profiles and text oracles have stable bytes on every checkout.
crates/graphit-ast/profiles/** text eol=lf
crates/graphit-ast/tests/fixtures/** text=auto eol=lf

# These fixtures exercise significant trailing spaces and implicit YAML nulls.
crates/graphit-knowledge/tests/fixtures/document/rich.md -whitespace
crates/graphit-ast/tests/fixtures/profiles/schema-cases/exports-null-implicit.yaml -whitespace
crates/graphit-ast/tests/fixtures/catalog/joint/unicode-crlf.yaml text eol=crlf
crates/graphit-ast/tests/fixtures/profiles/schema-cases/unicode-crlf.yaml text eol=crlf
crates/graphit-ast/tests/fixtures/symbols/unicode-crlf.js text eol=crlf

# Preserve generated bundle bytes, including whitespace in vendor literals.
crates/graphit-app/assets/ui/index.html linguist-generated=true -whitespace

# The qualified SDK projection is hashed identically on every checkout.
crates/graphit-fs/src/macos_private_sdk.rs text eol=lf

# Compiled instructions and byte-for-byte role snapshots use LF on every host.
templates/agent-instructions/** text eol=lf
crates/graphit-runtime/tests/fixtures/agent-instructions/*.md text eol=lf
